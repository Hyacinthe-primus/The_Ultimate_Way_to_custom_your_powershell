{
  // Base fastfetch configuration.
  // fastfetch-random.ps1 overrides the logo file and the logo colors at launch,
  // so the logo section below only matters when you run `fastfetch` directly.
  // Colors use the "38;2;R;G;B" format, which every fastfetch version accepts.
  // The palette below is Catppuccin Mocha (rosewater, flamingo, pink, peach, yellow,
  // green, teal, sky, sapphire).
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "color": {
      "1": "38;2;245;224;220",
      "2": "38;2;242;205;205",
      "3": "38;2;245;194;231",
      "4": "38;2;250;179;135",
      "5": "38;2;249;226;175",
      "6": "38;2;166;227;161",
      "7": "38;2;148;226;213",
      "8": "38;2;137;220;235",
      "9": "38;2;116;199;236"
    },
    "padding": {
      "top": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "38;2;245;194;231",
        "at": "38;2;205;214;244",
        "host": "38;2;137;220;235"
      }
    },
    "break",
    {
      "type": "os",
      "key": "",
      "keyColor": "38;2;137;220;235"
    },
    {
      "type": "cpu",
      "key": "",
      "keyColor": "38;2;245;194;231"
    },
    {
      "type": "board",
      "key": "󰚗",
      "keyColor": "38;2;250;179;135"
    },
    {
      "type": "memory",
      "key": "",
      "keyColor": "38;2;166;227;161",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "",
      "keyColor": "38;2;148;226;213"
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
